[
  {
    "type": "function",
    "function": {
      "name": "read_evidence",
      "description": "Read exact registered text or native numeric pages; omit handle for catalog.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "handle": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Handle"
          },
          "start": {
            "default": 0,
            "minimum": 0,
            "title": "Start",
            "type": "integer"
          },
          "limit": {
            "anyOf": [
              {
                "maximum": 2000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Limit"
          }
        },
        "title": "ReadEvidence",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "transform",
      "description": "Transform raw detector data using supplied PONI and explicit mask/geometry choices.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Label",
            "type": "string"
          },
          "mask_policy": {
            "enum": [
              "supplied",
              "omit"
            ],
            "title": "Mask Policy",
            "type": "string"
          },
          "incident_angle": {
            "maximum": 90,
            "minimum": 0,
            "title": "Incident Angle",
            "type": "number"
          },
          "sample_orientation": {
            "maximum": 4,
            "minimum": 1,
            "title": "Sample Orientation",
            "type": "integer"
          },
          "tilt_angle": {
            "maximum": 180,
            "minimum": -180,
            "title": "Tilt Angle",
            "type": "number"
          },
          "distance_scale": {
            "default": 1.0,
            "exclusiveMinimum": 0,
            "maximum": 10,
            "title": "Distance Scale",
            "type": "number"
          }
        },
        "required": [
          "label",
          "mask_policy",
          "incident_angle",
          "sample_orientation",
          "tilt_angle"
        ],
        "title": "Transform",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "extract",
      "description": "Extract a nearest-bin, upper-exclusive mean strip; bounds are q in nm^-1.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Label",
            "type": "string"
          },
          "map_handle": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Map Handle",
            "type": "string"
          },
          "axis": {
            "default": "qr",
            "enum": [
              "qr",
              "qz"
            ],
            "title": "Axis",
            "type": "string"
          },
          "lower": {
            "title": "Lower",
            "type": "number"
          },
          "upper": {
            "title": "Upper",
            "type": "number"
          },
          "mode": {
            "enum": [
              "notebook",
              "coverage_aware"
            ],
            "title": "Mode",
            "type": "string"
          },
          "coordinate_definition": {
            "default": "q=2pi/d",
            "enum": [
              "q=2pi/d",
              "s=1/d"
            ],
            "title": "Coordinate Definition",
            "type": "string"
          }
        },
        "required": [
          "label",
          "map_handle",
          "lower",
          "upper",
          "mode"
        ],
        "title": "Extract",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "compare",
      "description": "Compare profiles over common covered support, without bridging coverage gaps.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Label",
            "type": "string"
          },
          "left": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Left",
            "type": "string"
          },
          "right": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Right",
            "type": "string"
          },
          "lower": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lower"
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Upper"
          }
        },
        "required": [
          "label",
          "left",
          "right"
        ],
        "title": "Compare",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit",
      "description": "Submit cited claims or a partial result; scientific validity remains unassessed.",
      "parameters": {
        "$defs": {
          "Claim": {
            "additionalProperties": false,
            "properties": {
              "text": {
                "maxLength": 4000,
                "minLength": 1,
                "title": "Text",
                "type": "string"
              },
              "evidence": {
                "items": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "title": "Evidence",
                "type": "array"
              }
            },
            "required": [
              "text",
              "evidence"
            ],
            "title": "Claim",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "supported",
              "partial"
            ],
            "title": "Status",
            "type": "string"
          },
          "claims": {
            "items": {
              "$ref": "#/$defs/Claim"
            },
            "title": "Claims",
            "type": "array"
          },
          "limitations": {
            "items": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Limitations",
            "type": "array"
          },
          "evidence_needed": {
            "items": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidence Needed",
            "type": "array"
          },
          "scientific_reward": {
            "default": null,
            "title": "Scientific Reward",
            "type": "null"
          },
          "scientific_qualified": {
            "const": false,
            "default": false,
            "title": "Scientific Qualified",
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "claims",
          "limitations",
          "evidence_needed"
        ],
        "title": "Submission",
        "type": "object"
      }
    }
  }
]
