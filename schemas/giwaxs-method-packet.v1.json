    "MethodEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "turn_index": {
          "minimum": 0,
          "title": "Turn Index",
          "type": "integer"
        },
        "call_index": {
          "minimum": 0,
          "title": "Call Index",
          "type": "integer"
        },
        "function_name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Function Name",
          "type": "string"
        },
        "arguments": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Arguments"
        },
        "transport_status": {
          "enum": [
            "started",
            "completed",
            "failed"
          ],
          "title": "Transport Status",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "success",
                "rejected",
                "failure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome"
        },
        "shown_observation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shown Observation"
        },
        "executor_observation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Executor Observation"
        },
        "executor_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Executor Sha256"
        },
        "clipped": {
          "title": "Clipped",
          "type": "boolean"
        }
