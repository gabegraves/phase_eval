          "additionalProperties": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Context",
          "type": "object"
        },
        "unknowns": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
