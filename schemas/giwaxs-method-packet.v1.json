{
  "$defs": {
    "Acquisition": {
      "additionalProperties": false,
      "properties": {
        "incident_angle": {
          "maximum": 90,
          "minimum": 0,
          "title": "Incident Angle",
          "type": "number"
        },
        "sample_orientation": {
          "maximum": 4,
          "minimum": 1,
          "title": "Sample Orientation",
          "type": "integer"
        },
        "tilt_angle": {
          "maximum": 180,
          "minimum": -180,
          "title": "Tilt Angle",
          "type": "number"
        }
      },
      "required": [
        "incident_angle",
        "sample_orientation",
        "tilt_angle"
      ],
      "title": "Acquisition",
      "type": "object"
    },
    "ArtifactReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "task_kind": {
          "const": "giwaxs",
          "default": "giwaxs",
          "title": "Task Kind",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Case Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "map",
            "profile",
            "comparison"
          ],
          "title": "Kind",
          "type": "string"
        },
        "handle": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Handle",
          "type": "string"
        },
        "parents": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Parents",
          "type": "object"
        },
        "inputs": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Outputs",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "coordinate": {
          "$ref": "#/$defs/Coordinate"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "warnings": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "scientific_reward": {
          "default": null,
          "title": "Scientific Reward",
          "type": "null"
        },
        "scientific_qualified": {
          "const": false,
          "default": false,
          "title": "Scientific Qualified",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "kind",
        "handle",
        "parents",
        "inputs",
        "outputs",
        "parameters",
        "coordinate",
        "runtime",
        "warnings"
      ],
      "title": "ArtifactReceipt",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
