    "GiwaxsCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Case Id",
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/FileRef"
        },
        "geometry": {
          "$ref": "#/$defs/FileRef"
