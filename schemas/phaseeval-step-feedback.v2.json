{
  "$defs": {
    "JudgeIdentity": {
      "additionalProperties": false,
      "description": "Present only on model_judge records: which model answered under which frozen prompt.\nEach judge label comes from a fresh tool-less invocation whose whole input is the frozen\nprompt plus one snapshot; `input_sha256` is the sha256 of that exact input payload, and the\njudge script refuses a payload carrying any custody field (PI security directive).",
      "properties": {
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "judge_is_actor_model": {
          "title": "Judge Is Actor Model",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "prompt_sha256",
        "input_sha256",
        "run_id",
        "judge_is_actor_model"
      ],
      "title": "JudgeIdentity",
      "type": "object"
    },
    "Rater": {
      "additionalProperties": false,
      "description": "Stamped by the LabelStore from the authenticated principal, never from the request: the\nkind derives from the principal type and roles (rater_kind_for). No request type has a\nrater or rater_kind field, and extra=\"forbid\" rejects a body that supplies one.",
      "properties": {
        "principal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Principal Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "expert",
            "owner",
            "model_judge"
          ],
          "title": "Kind",
          "type": "string"
        },
        "judge": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "principal_id",
        "kind"
      ],
      "title": "Rater",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "phaseeval.step-feedback.v2",
      "default": "phaseeval.step-feedback.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot",
      "type": "string"
    },
    "attempt": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt",
      "type": "string"
    },
    "call_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Index"
    },
    "mark": {
      "enum": [
        "wrong_move",
        "went_wrong_here",
        "good_move",
        "note"
      ],
      "title": "Mark",
      "type": "string"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "rater": {
      "$ref": "#/$defs/Rater"
    },
    "exposure": {
      "enum": [
        "blind",
        "revealed"
      ],
      "title": "Exposure",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    }
  },
  "required": [
    "snapshot",
    "attempt",
    "mark",
    "rater",
    "exposure",
    "created_at_utc"
  ],
  "title": "StepFeedback",
  "type": "object",
  "$id": "schemas/phaseeval-step-feedback.v2.json"
}
